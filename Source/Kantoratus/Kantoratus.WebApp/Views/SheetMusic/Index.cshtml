@model IEnumerable<Kantoratus.Domain.Chapter>

<section class="intro-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="section-title">
                    <h2>Doktori</h2>
                </div>
            </div>
            <div class="col-lg-6">
                <p>
                    A kántorátus vezetője, Pap Kinga Marjatta 2026 őszén védi meg hittudományi doktori dolgozatát az Evangélikus ittudományi Egyetemen. A dolgozat alkalmazott eredményei közé tartozik az a 30 tétel, amelynek énekelhető magyar nyelvű változatát itt bocsátjuk közre.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="songs-details-section sheet-music-section">
    @foreach (var chapter in Model)
    {
        <h3>@chapter.Name</h3>
        @foreach (var subChapter in chapter.SubChapters)
        {
            <h4>@subChapter.Name</h4>
            <partial name="~/Views/SheetMusic/SheetMusicListPartial.cshtml" model="@subChapter.SheetMusics" />
        }
    }
</section>

<section class="songs-details-section original-titles-section">
    <h3>Eredeti nyelvű címek jegyzéke</h3>
    <ul class="original-titles-list">
        @foreach (var sheetMusic in Model.SelectMany(c => c.SubChapters).SelectMany(sc => sc.SheetMusics).OrderBy(sm => sm.OriginalTitle))
        {
            <li class="original-title-row">
                <a asp-action="Details" asp-controller="SheetMusic" asp-route-number="@sheetMusic.Number">
                    <span class="original-title">@sheetMusic.OriginalTitle</span>
                    <strong class="text-red original-title-number">@sheetMusic.Number</strong>
                </a>
            </li>
        }
    </ul>
</section>