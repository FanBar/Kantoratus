@model Kantoratus.Domain.SheetMusic

<section class="intro-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="section-title">
                    <h2 class="text-red">@Model.Number</h2>
                    <h3>@Model.Chapter</h3>
                    <h4>@Model.SubChapter</h4>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="intro-section spad">
    <div class="container">
        <div class="row">
            @foreach(var image in Model.Images)
            {
                <img class="slideImage" src="@image">
            }
        </div>
    </div>
</section>

<section class="intro-section spad">
    <div class="container">
        <div class="lyrics-container">
            @Html.Raw(Model.Lyrics)
        </div>
    </div>
</section>

<section class="intro-section spad">
    <div class="container">
        <div class="row">
                <ul class="small-text">
                    <li>@Model.Origin</li>
                    <li>@Model.HimnologicalData1</li>
                    <li>@Model.HimnologicalData2</li>
                </ul>
        </div>
    </div>
</section>

@if (Model.Previous != null){
    <a asp-controller="SheetMusic" asp-action="Details" asp-route-number="@Model.Previous" class="w3-button w3-display-left">
        &#10094;
    </a>
}
@if (Model.Next != null){
<a asp-controller="SheetMusic" asp-action="Details" asp-route-number="@Model.Next" class="w3-button w3-display-right">
    &#10095;
</a>
}